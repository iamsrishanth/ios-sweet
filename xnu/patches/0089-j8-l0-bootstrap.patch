diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index e29b0d7..e404046 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -976,9 +976,16 @@
 #define T1SZ_BOOT 17ULL
 #endif /* !__ARM64_PMAP_SUBPAGE_L1__ */
 #else /* __ARM_16K_PG__ */
-#if __ARM64_PMAP_SUBPAGE_L1__
+#if defined(ARM64_BOARD_CONFIG_J8)
+/*
+ * J8: the macOS-platform kernel is linked at -2 TiB (41 significant bits).
+ * A 39-bit TTBR1 (T1SZ 25) does not cover it, so use 41 bits and the L0
+ * bootstrap table built in start.s.
+ */
+#define T1SZ_BOOT 23ULL
+#elif __ARM64_PMAP_SUBPAGE_L1__
 #define T1SZ_BOOT 26ULL
-#else /* __ARM64_PMAP_SUBPAGE_L1__ */
+#else /* !__ARM64_PMAP_SUBPAGE_L1__ */
 #define T1SZ_BOOT 25ULL
 #endif /*__ARM64_PMAP_SUBPAGE_L1__*/
 #endif /* __ARM_16K_PG__ */
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index f1b3049..6a15ed6 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -420,6 +420,29 @@ start_cpu:
 	str		$5, [$3]							// Write entry to L1 table
 .endmacro
 
+/*
+ * create_l0_table_entry
+ *
+ * Points an L0 entry at the L1 table for the given virtual address. Used on
+ * J8, where T1SZ_BOOT is 23 (41-bit) and the walk therefore starts at L0.
+ *   arg0 - Virtual address
+ *   arg1 - L0 table address
+ *   arg2 - L1 table address
+ *   arg3 - Scratch register
+ *   arg4 - Scratch register
+ *   arg5 - Scratch register
+ */
+.macro create_l0_table_entry
+	and		$3,	$0, #(ARM_TT_L0_INDEX_MASK)
+	lsr		$3, $3, #(ARM_TT_L0_SHIFT)
+	lsl		$3, $3, #(TTE_SHIFT)
+	add		$3, $1, $3
+	mov		$4, #(ARM_TTE_BOOT_TABLE)
+	and		$5, $2, #(ARM_TTE_TABLE_MASK)
+	orr		$5, $4, $5
+	str		$5, [$3]
+.endmacro
+
 /*
  * create_l2_block_entries
  *
@@ -664,7 +687,17 @@ Lkernelcache_base_found:
 	 */
 	mov		x1, x25
 	add		x3, x1, PGBYTES
+#if defined(ARM64_BOARD_CONFIG_J8)
+	/*
+	 * J8: T1SZ_BOOT is 23 (41-bit), so the KVA walk starts at L0.
+	 * x13 - KVA L0 page; x2 - free page after the L0/L1 roots.
+	 */
+	add		x13, x3, PGBYTES
+	add		x2, x13, PGBYTES
+	create_l0_table_entry x14, x13, x3, x6, x7, x8
+#else
 	mov		x2, x3
+#endif
 
 	/*
 	 * Setup the V=P bootstrap mapping
@@ -744,7 +777,11 @@ common_start:
 	mov		x19, lr
 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19
+#if defined(ARM64_BOARD_CONFIG_J8)
+	add		x0, x25, #(2 * PGBYTES)		// KVA L0 root
+#else
 	add		x0, x25, PGBYTES
+#endif
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
