diff --git a/iokit/Kernel/IOPlatformExpert.cpp b/iokit/Kernel/IOPlatformExpert.cpp
index 7a32a23..3bbe3db 100644
--- a/iokit/Kernel/IOPlatformExpert.cpp
+++ b/iokit/Kernel/IOPlatformExpert.cpp
@@ -2053,15 +2053,29 @@ IOPlatformExpertDevice::init(void *dtRoot)
 	return true;
 }
 
+#if defined(ARM64_BOARD_CONFIG_J8)
+extern volatile uint64_t g_j8_io_dbg[4];
+#define J8_IO_STAGE(s) do { \
+	g_j8_io_dbg[0] = 0x4a38494f44424731ULL; \
+	g_j8_io_dbg[1] = (uint64_t)(s); \
+} while (0)
+#else
+#define J8_IO_STAGE(s) do { } while (0)
+#endif
+
 bool
 IOPlatformExpertDevice::startIOServiceMatching(void)
 {
+	J8_IO_STAGE(0x13);
 	workLoop = IOWorkLoop::workLoop();
 	if (!workLoop) {
+		J8_IO_STAGE(0xbad1);
 		return false;
 	}
+	J8_IO_STAGE(0x14);
 
 	registerService();
+	J8_IO_STAGE(0x15);
 
 	return true;
 }
