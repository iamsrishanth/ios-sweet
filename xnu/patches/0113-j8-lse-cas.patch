diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index c4be2be..3c56c7a 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -931,9 +931,52 @@ j8_lse_new(uint32_t opc, uint64_t old, uint64_t rs, uint32_t size)
 	}
 }
 
+static boolean_t
+j8_lse_cas(arm_saved_state_t *state, uint32_t size,
+    uint32_t rs, uint32_t rn, uint32_t rt)
+{
+	uint64_t addr = get_saved_state_reg(state, rn);
+	uint64_t cmp = get_saved_state_reg(state, rs);
+	uint64_t val = get_saved_state_reg(state, rt);
+	uint64_t old;
+
+	if (size == 3) {
+		volatile uint64_t *p = (volatile uint64_t *)(uintptr_t)addr;
+		uint64_t expected = cmp;
+		__atomic_compare_exchange_n(p, &expected, val, false,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+		old = expected;
+	} else if (size == 2) {
+		volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)addr;
+		uint32_t expected = (uint32_t)cmp, value = (uint32_t)val;
+		__atomic_compare_exchange_n(p, &expected, value, false,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+		old = expected;
+	} else if (size == 1) {
+		volatile uint16_t *p = (volatile uint16_t *)(uintptr_t)addr;
+		uint16_t expected = (uint16_t)cmp, value = (uint16_t)val;
+		__atomic_compare_exchange_n(p, &expected, value, false,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+		old = expected;
+	} else {
+		volatile uint8_t *p = (volatile uint8_t *)(uintptr_t)addr;
+		uint8_t expected = (uint8_t)cmp, value = (uint8_t)val;
+		__atomic_compare_exchange_n(p, &expected, value, false,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+		old = expected;
+	}
+	set_saved_state_reg(state, rt, old);
+	set_saved_state_pc(state, get_saved_state_pc(state) + 4);
+	return TRUE;
+}
+
 static boolean_t
 j8_lse_emulate(arm_saved_state_t *state, uint32_t instr)
 {
+	if ((instr & 0x3F200C00) == 0x08200C00) {
+		return j8_lse_cas(state, instr >> 30, (instr >> 16) & 0x1f,
+		    (instr >> 5) & 0x1f, instr & 0x1f);
+	}
 	if ((instr & 0x3F200C00) != 0x38200000) {
 		return FALSE;
 	}
